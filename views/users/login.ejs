<% layout("/layouts/boilerplate") %>

<div class="row mt-3">
    <h1 class="col-8 offset-2">Login</h1> 
    <div class="col-8 offset-2">

        <!-- Login Form -->
        <form action="/login" method="POST" class="needs-validation" novalidate>

            <!-- ================= Username ================= -->
            <div class="mb-3">
                <label for="username" class="form-label">
                    Username
                </label>

                <input
                    type="text"
                    id="username"
                    name="username"
                    placeholder="Enter Username"
                    class="form-control"
                    required
                >

                <!-- <div class="valid-feedback">
                    Looks good!
                </div> -->
            </div>

            <!-- ================= Password ================= -->
            <div class="mb-3">
                <label for="password" class="form-label">
                    Password
                </label>

                <input
                    type="password"
                    id="password"
                    name="password"
                    placeholder="Enter Password"
                    class="form-control"
                    required
                >

                <div class="valid-feedback">
                    Looks good!
                </div>
            </div>

            <!-- ================= Submit Button ================= -->
            <button class="btn btn-dark">
                Log In
            </button>

        </form>

    </div>
</div>