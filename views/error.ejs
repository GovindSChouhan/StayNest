<% layout("/layouts/boilerplate")%>

<div class="row mt-3">
    <div class="alert alert-danger col-6 offset-3" role="alert">
        <!-- <class="bi flex-shrink-0 me-2" width="24" height="24" role="img" aria-label="Danger:"><use xlink:href="#exclamation-triangle-fill"/></svg> -->
      
        <p class="alert-heading"><%= message %></p>
        <!--All errror <p><= err.stack %></p>  -->
    
 
