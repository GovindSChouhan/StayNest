<!-- =====================================================
     HERO SECTION

     Purpose:
     Creates a modern landing banner.

     Only frontend UI changes.

     No backend functionality modified.
===================================================== -->
<section class="hero text-center mb-5">
    <div class="hero-content">

    <h1 class="display-5 fw-bold">
        Find Your Perfect Student Stay
    </h1>

    <p class="lead mt-3">
        Safe • Affordable • Verified Student Accommodation
    </p>

    <p>
        Search PGs, Hostels, Shared Apartments and Rental Rooms
        near your college.
    </p>

    <a href="/listings"
       class="btn btn-danger rounded-pill px-4 mt-3 hero-btn">

        Browse Rooms

    </a>

</div>
</section>


