<!--when click on img go on show Page-->


    <!-- BASIC CARD -->
    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">

   <% for(let listing of allListings) { %> 
    <a href="/listings/<%= listing._id %>" class="listing-link">


    <div class="card col listing-card" >
        <!-- img src="<%= listing.image.url %>" class="card-img-top" alt="listing_image" style="height:20rem"/>  -->
         <!-- ========================================================= -->
<!-- Listing Image                                             -->
<!--                                                           -->
<!-- src            : Displays the image stored in MongoDB.    -->
<!-- class          : Applies Bootstrap card image styling.    -->
<!-- alt            : Shows text if the image fails to load.   -->
<!--                  Also improves accessibility and SEO.     -->
<!-- loading="lazy" : Improves performance by loading images   -->
<!--                  only when they are about to appear on    -->
<!--                  the user's screen while scrolling.       -->
<!--                                                           -->
<!-- Result:                                                   -->
<!-- Instead of downloading all images at once, the browser    -->
<!-- loads images only when needed, making the page faster.    -->
<!--  -->

<img
    src="<%= listing.image.url %>"
    class="card-img-top"
    alt="<%= listing.title %>"
    loading="lazy"

>
<!-- ========================================================= -->

    <!-- to add image overlays 1 line down only not other-->
    <div class="card-img-overlay">Govind</div>

        <div class="card-body"> 
            <p class="card-text">
                <b><%= listing.title %></b><br />
                &#8377;<%= listing.price.toLocaleString("en-IN")%>/Night

            </p> 
        </div> 
    </div> 
    </a>
<% } %>
</div>



